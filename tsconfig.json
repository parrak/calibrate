{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@calibr/db": ["packages/db/index.ts"],
      "@calibr/db/*": ["packages/db/*"],
      "@calibr/pricing-engine/*": ["packages/pricing-engine/*"],
      "@calibr/security/*": ["packages/security/*"],
      "@calibr/connectors/*": ["packages/connectors/*"],
      "@calibr/amazon-connector/*": ["packages/amazon-connector/*"],
      "@calibr/shopify-connector": ["packages/shopify-connector/src/index.ts"],
      "@calibr/shopify-connector/*": ["packages/shopify-connector/src/*"],
      "@calibr/platform-connector/*": ["packages/platform-connector/src/*"],
      "@calibr/ui/*": ["packages/ui/*"],
      "@calibr/monitor": ["packages/monitor/src/index.ts"],
      "@calibr/monitor/*": ["packages/monitor/src/*"],
      "@calibr/types/*": ["packages/types/*"],
      "@calibr/automation-runner": ["packages/automation-runner/src/index.ts"],
    "@calibr/automation-runner/*": ["packages/automation-runner/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
