{
  "name": "@calibr/automation-runner",
  "version": "0.1.0",
  "type": "module",
  "description": "Automation runner for bulk pricing rule execution with retry and reconciliation",
  "main": "./dist/automation-runner/src/index.js",
  "types": "./dist/automation-runner/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/automation-runner/src/index.d.ts",
      "import": "./dist/automation-runner/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@calibr/db": "workspace:*",
    "@calibr/monitor": "workspace:*",
    "@calibr/pricing-engine": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
